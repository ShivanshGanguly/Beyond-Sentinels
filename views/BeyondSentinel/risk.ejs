<% layout("layouts/boilerplate.ejs") %>

    <style>
        :root {
            --navy: #0b1220;
            --blue: #42d9f5;
            --cyan: #59c7ff;
            --teal: #2dd4bf;
            --red: #fb7185;
            --orange: #fbbf24;
            --green: #34d399;
            --bg: #07111f;
            --panel: #0d1b2b;
            --panel-light: #13263a;
            --border: #263b55;
            --text: #e5eefb;
            --muted: #9aadc4;
        }

        body {
            background: var(--bg) !important;
            color: var(--text);
        }

        .dashboard,
        #risk,
        #intervene,
        #budgetPlanner {
            color: var(--text);
            background: transparent;
        }

        .dashboard {
            padding: 18px;
        }

        .dashboard-header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            flex-wrap: wrap;
            gap: 20px;
            padding: 24px 28px;
            margin-bottom: 22px;
            background: linear-gradient(120deg, #11263b, #102033);
            border: 1px solid var(--border);
            border-radius: 18px;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.2);
        }

        .dashboard-header h1 {
            margin: 0;
            color: var(--text);
            font-size: clamp(1.7rem, 3vw, 2.5rem);
            font-weight: 800;
            letter-spacing: -1px;
        }

        .ward-select-wrapper {
            min-width: 240px;
        }

        .ward-select-wrapper label {
            color: var(--text);
            font-size: 0.9rem;
            margin-bottom: 7px;
        }

        .ward-select,
        #intervene .form-control,
        #intervene .form-select {
            width: 100%;
            padding: 11px 14px;
            background-color: #091827 !important;
            color: var(--text) !important;
            border: 1px solid #36516f;
            border-radius: 10px;
        }

        .ward-select:focus,
        #intervene .form-control:focus,
        #intervene .form-select:focus {
            border-color: var(--cyan);
            box-shadow: 0 0 0 3px rgba(89, 199, 255, 0.15);
        }

        .ward-select option,
        #intervene .form-select option {
            background: var(--panel);
            color: var(--text);
        }

        .heatmap-card {
            width: 100%;
            padding: 8px;
            background: var(--panel);
            border: 1px solid var(--border);
            border-radius: 17px;
            box-shadow: 0 8px 25px rgba(0, 0, 0, 0.2);
            overflow: hidden;
        }

        #mumbaiHeatmap {
            width: 100%;
            height: 550px;
            border-radius: 12px;
            z-index: 1;
        }

        .metric-card {
            position: relative;
            display: flex;
            flex-direction: column;
            justify-content: center;
            min-height: 170px;
            padding: 22px;
            background: var(--panel) !important;
            color: var(--text) !important;
            border: 1px solid var(--border) !important;
            border-radius: 16px;
            box-shadow: 0 8px 24px rgba(0, 0, 0, 0.18);
            transition: transform 0.2s ease, border-color 0.2s ease;
        }

        .metric-card:hover {
            transform: translateY(-3px);
            border-color: var(--cyan) !important;
        }

        .metric-card h5 {
            font-size: 0.98rem;
            font-weight: 700;
            margin-bottom: 18px;
            line-height: 1.5;
            color: var(--muted);
        }

        .metric-card h1 {
            font-size: clamp(1.8rem, 3vw, 2.5rem);
            font-weight: 800;
            margin: 0;
            overflow-wrap: anywhere;
            color: var(--cyan);
        }

        .metric-card.bg-danger-subtle {
            background: linear-gradient(135deg, #271a2a, #171a2a) !important;
            border-color: #854052 !important;
        }

        .metric-card.bg-danger-subtle h1 {
            color: var(--red);
        }

        .metric-card.bg-warning-subtle {
            background: linear-gradient(135deg, #29251a, #191e2a) !important;
            border-color: #80632e !important;
        }

        .metric-card.bg-warning-subtle h1 {
            color: var(--orange);
        }

        .metric-card.bg-info-subtle {
            background: linear-gradient(135deg, #112b3c, #121d30) !important;
            border-color: #285c78 !important;
        }

        .metric-card.bg-info-subtle h1 {
            color: var(--cyan);
        }

        #intervene,
        #budgetPlanner {
            margin: 26px 0;
            padding: 24px;
            background: linear-gradient(145deg, #0d1b2b, #0a1726) !important;
            color: var(--text) !important;
            border: 1px solid var(--border);
            border-radius: 18px;
            box-shadow: 0 12px 35px rgba(0, 0, 0, 0.2);
            overflow: hidden;
        }

        #intervene h1,
        #intervene h2,
        #intervene h3,
        #budgetPlanner h1,
        #budgetPlanner h2,
        #budgetPlanner h3,
        #budgetPlanner h4 {
            color: var(--text) !important;
            font-weight: 800;
        }

        #intervene h1,
        #intervene h2 {
            font-size: clamp(1.6rem, 3vw, 2.25rem);
            margin-bottom: 16px;
        }

        #intervene h3 {
            font-size: 1.35rem;
            margin-bottom: 18px;
        }

        #intervene p,
        #budgetPlanner p {
            color: var(--muted);
            line-height: 1.7;
        }

        #intervene .mb-3 {
            margin-top: 22px;
            padding: 20px;
            background: var(--panel) !important;
            border: 1px solid var(--border);
            border-radius: 14px;
        }

        #intervene label {
            display: block;
            color: var(--text);
            font-weight: 650;
            margin-bottom: 10px;
        }

        #budgetInput {
            max-width: 360px;
            min-height: 48px;
        }

        #generateBudgetBtn {
            min-height: 45px;
            padding: 11px 20px;
            color: #071522;
            background: linear-gradient(135deg, var(--cyan), var(--teal));
            border: none;
            border-radius: 10px;
            font-weight: 750;
            transition: transform 0.2s ease, box-shadow 0.2s ease;
        }

        #generateBudgetBtn:hover {
            color: #071522;
            background: #72e7fa;
            transform: translateY(-2px);
            box-shadow: 0 8px 24px rgba(45, 212, 191, 0.2);
        }

        #generateBudgetBtn:focus-visible {
            outline: 2px solid var(--cyan);
            outline-offset: 3px;
        }

        #budgetStatus {
            margin: 16px 0;
            color: var(--cyan) !important;
            font-weight: 600;
        }

        #budgetSummary {
            margin: 20px 0;
            padding: 20px;
            background: #102438 !important;
            color: var(--text) !important;
            border: 1px solid #28516a;
            border-radius: 14px;
            line-height: 1.8;
        }

        #budgetSummary h1,
        #budgetSummary h2,
        #budgetSummary h3,
        #budgetSummary h4,
        #budgetSummary h5 {
            color: var(--cyan) !important;
        }

        #budgetSummary strong {
            color: var(--teal);
        }

        .budget-section {
            margin: 26px 0;
            padding: 0 !important;
            background: #0b1727 !important;
            border: 1px solid var(--border);
            border-radius: 18px;
            box-shadow: 0 12px 35px rgba(0, 0, 0, 0.2);
            overflow: hidden;
        }

        .budget-header {
            padding: 24px 26px;
            background: linear-gradient(115deg, #14283c, #102333 55%, #10313b) !important;
            border-bottom: 1px solid var(--border);
        }

        .budget-header h2 {
            color: var(--text) !important;
            font-size: clamp(1.5rem, 3vw, 2.1rem);
            font-weight: 800;
            margin-bottom: 9px;
        }

        .budget-header p {
            color: var(--muted) !important;
            margin: 0;
            font-size: 0.98rem;
        }

        .budget-content {
            padding: 22px;
            background: #0b1727 !important;
            color: var(--text) !important;
        }

        .budget-card {
            height: 100%;
            padding: 22px;
            border-radius: 15px;
            background: linear-gradient(135deg, #123c43, #122b3c) !important;
            color: var(--text) !important;
            border: 1px solid #287b80;
            box-shadow: 0 8px 24px rgba(0, 0, 0, 0.18);
            display: flex;
            flex-direction: column;
            justify-content: center;
        }

        .budget-card strong {
            color: #a7e9e7 !important;
            font-size: 1rem;
        }

        .budget-card h2 {
            color: var(--teal) !important;
            font-size: clamp(2rem, 4vw, 2.5rem);
            font-weight: 800;
            margin-top: 12px;
        }

        .budget-content h4 {
            color: var(--cyan) !important;
            font-size: 1.15rem;
            font-weight: 750;
            margin-bottom: 14px;
        }

        #comparision {
            margin-top: 10px;
            padding: 20px;
            background: #0d1b2b !important;
            color: var(--text) !important;
            border: 1px solid var(--border);
            border-radius: 15px;
        }

        #comparision h4 {
            color: var(--cyan) !important;
            margin-bottom: 18px;
        }

        .table-responsive {
            margin-bottom: 8px;
            border: 1px solid var(--border);
            border-radius: 12px;
            background: var(--panel) !important;
            overflow-x: auto;
        }

        #intervene .table,
        #budgetPlanner .table {
            width: 100%;
            margin-bottom: 0;
            vertical-align: middle;
            color: var(--text) !important;
            background: var(--panel) !important;
            border-color: var(--border) !important;
            --bs-table-bg: #0d1b2b;
            --bs-table-color: #d7e5f1;
            --bs-table-border-color: #263b55;
            --bs-table-hover-bg: #172d42;
            --bs-table-hover-color: #ffffff;
        }

        #intervene .table thead th,
        #budgetPlanner .table thead th {
            padding: 15px 17px;
            font-size: 0.9rem;
            font-weight: 750;
            white-space: nowrap;
            color: #eafaff !important;
            background: #16344b !important;
            border-color: var(--border) !important;
        }

        #intervene .table tbody tr,
        #budgetPlanner .table tbody tr {
            background: #0d1b2b !important;
        }

        #intervene .table tbody td,
        #budgetPlanner .table tbody td {
            padding: 14px 17px;
            font-size: 0.92rem;
            color: #c8d7e9 !important;
            background: #0d1b2b !important;
            border-color: var(--border) !important;
        }

        #intervene .table tbody tr:hover td,
        #budgetPlanner .table tbody tr:hover td {
            color: #ffffff !important;
            background: #172d42 !important;
        }

        #intervene .table .table-dark,
        #budgetPlanner .table .table-dark,
        #intervene .table thead.table-dark th,
        #budgetPlanner .table thead.table-dark th,
        #intervene .table-dark th,
        #budgetPlanner .table-dark th {
            color: #eafaff !important;
            background: #16344b !important;
            border-color: var(--border) !important;
        }

        #recommendedPlan td,
        #beforeAfterTable td {
            color: var(--muted) !important;
        }

        #wardPriorityTable thead th {
            background: #7f293e !important;
            color: #ffffff !important;
            border-color: var(--border) !important;
        }

        #interventionMenu thead th {
            background: #12433f !important;
            color: #eafffb !important;
        }

        #recommendedPlan thead th {
            background: #16344b !important;
            color: #eafaff !important;
        }

        #risk .card {
            color: var(--text);
        }

        @media (max-width: 991px) {
            #mumbaiHeatmap {
                height: 600px;
            }

            .metric-card {
                min-height: 145px;
            }
        }

        @media (max-width: 767px) {
            .dashboard {
                padding: 9px;
            }

            .dashboard-header {
                padding: 18px;
            }

            .ward-select-wrapper {
                width: 100%;
            }

            #mumbaiHeatmap {
                height: 480px;
            }

            .metric-card {
                min-height: 125px;
                padding: 17px;
            }

            #intervene,
            #budgetPlanner {
                padding: 15px;
            }

            .budget-content {
                padding: 14px;
            }

            .budget-header {
                padding: 19px;
            }

            #comparision {
                padding: 12px;
            }

            #intervene .table thead th,
            #budgetPlanner .table thead th,
            #intervene .table tbody td,
            #budgetPlanner .table tbody td {
                padding: 11px;
                font-size: 0.82rem;
            }

            #budgetInput {
                max-width: 100%;
                width: 100%;
            }

            #generateBudgetBtn {
                width: 100%;
            }
        }

        @media (prefers-reduced-motion: reduce) {

            *,
            *::before,
            *::after {
                scroll-behavior: auto !important;
                transition-duration: 0.01ms !important;
                animation-duration: 0.01ms !important;
            }
        }
    </style>

    <div class="container-fluid dashboard theme-midnight" id="risk">
        <div class="dashboard-header">
            <h1 class="heading-1 fw-bold">Risk Heatmap</h1>

            <div class="ward-select-wrapper">
                <label for="wardSelect" class="form-label fw-bold">Select Ward:</label>
                <select id="wardSelect" class="form-select ward-select">
                    <option value="">Loading wards...</option>
                </select>
            </div>
        </div>

        <div class="row g-3">
            <div class="col-12 col-lg-9">
                <div class="card heatmap-card">
                    <div id="mumbaiHeatmap"></div>
                </div>
            </div>

            <div class="col-12 col-lg-3">
                <div class="card metric-card bg-danger-subtle border-danger">
                    <h5>Wet Bulb Globe Temperature (WBGT)</h5>
                    <h1 id="wbgtValue">Loading...</h1>
                </div>

                <div class="card metric-card bg-warning-subtle border-warning mt-3">
                    <h5>Heat Mortality Risk Index (HMRI)</h5>
                    <h1 id="hmriValue">Loading...</h1>
                </div>

                <div class="card metric-card bg-info-subtle border-info mt-3">
                    <h5>Risk Level</h5>
                    <h1 id="riskLevel">Loading...</h1>
                </div>
            </div>
        </div>
    </div>
    <section class="container-fluid theme-midnight" id="intervene">
        <h2>Cool Block Commander: Budget Planner</h2>
        <p>Allocate a budget to reduce heat vulnerability across Mumbai wards.</p>

        <div class="mb-3">
            <label for="budgetInput">Total Budget (₹ lakh)</label>
            <input id="budgetInput" type="number" min="0.01" step="0.01" value="50" class="form-control">
            <button id="generateBudgetBtn" type="button" class="btn btn-primary mt-2">
                Generate Budget Plan
            </button>
        </div>

        <p id="budgetStatus" role="status"></p>

        <div id="budgetSummary"></div>

        <div class="table-responsive mt-3">
            <table class="table table-bordered">
                <thead>
                    <tr>
                        <th>Ward</th>
                        <th>Intervention</th>
                        <th>Estimated Cost</th>
                        <th>Reduction in Vulnerability</th>
                    </tr>
                </thead>
                <tbody id="recommendedPlan">
                    <tr>
                        <td colspan="7">Enter a budget and generate a plan.</td>
                    </tr>
                </tbody>
            </table>
        </div>
    </section>


    <section class="container-fluid budget-section theme-midnight" id="budgetPlanner">

        <div class="budget-content">
            <div id="comparision" class="theme-midnight">
                <h4>Before and After: Ward Vulnerability</h4>

                <div class="table-responsive">
                    <table class="table table-bordered table-hover">
                        <thead class="table-dark">
                            <tr>
                                <th>Ward</th>
                                <th>Ward ID</th>
                                <th>Before</th>
                                <th>After</th>
                                <th>Reduction</th>
                            </tr>
                        </thead>
                        <tbody id="beforeAfterTable">
                            <tr>
                                <td colspan="5">Loading comparison...</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>

        </div>
    </section>

    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css">
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
    <script src="/js/dashboard.js" defer></script>