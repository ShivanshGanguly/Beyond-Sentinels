<% layout("layouts/boilerplate.ejs") %>

    <style>
        .dashboard {
            padding: 15px;
        }

        .dashboard-header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 15px;
            flex-wrap: wrap;
            margin-bottom: 15px;
        }

        .dashboard-header h1 {
            margin: 0;
        }

        .ward-select {
            width: 240px;
            max-width: 100%;
            padding: 10px;
            border-radius: 8px;
        }

        .metric-card {
            border-radius: 12px;
            padding: 20px;
            min-height: 175px;
            box-shadow: 0 3px 12px rgba(0, 0, 0, 0.08);
            display: flex;
            flex-direction: column;
            justify-content: center;
        }

        .metric-card h5 {
            font-size: 1rem;
            margin-bottom: 18px;
        }

        .metric-card h1 {
            font-size: clamp(1.7rem, 3vw, 2.6rem);
            font-weight: 700;
            overflow-wrap: anywhere;
        }

        .heatmap-card {
            width: 100%;
            border-radius: 12px;
            overflow: hidden;
            margin: 0;
        }

        #mumbaiHeatmap {
            height: 550px;
            width: 100%;
        }

        @media(max-width:991px) {
            #mumbaiHeatmap {
                height: 600px;
            }

            .metric-card {
                min-height: 140px;
            }
        }

        @media(max-width:767px) {
            .dashboard {
                padding: 8px;
            }

            .dashboard-header {
                align-items: stretch;
            }

            .ward-select {
                width: 100%;
            }

            #mumbaiHeatmap {
                height: 480px;
            }

            .metric-card {
                min-height: 120px;
                padding: 15px;
            }
        }
    </style>

    <div class="container-fluid dashboard" id="risk">

        <div class="dashboard-header">
            <h1 class="heading-1 fw-bold">Risk Heatmap</h1>

            <select id="wardSelect" class="form-select ward-select">
                <option value="">Loading wards...</option>
            </select>
        </div>

        <div class="row g-3">

            <div class="col-12 col-lg-9">
                <div class="card heatmap-card">
                    <div id="mumbaiHeatmap"></div>
                </div>
            </div>

            <div class="col-12 col-lg-3">

                <div class="card metric-card bg-danger-subtle border-danger">
                    <h5>Wet Bulb Globe Temperature (WBGT)</h5>
                    <h1 id="wbgtValue">Loading...</h1>
                </div>

                <div class="card metric-card bg-warning-subtle border-warning mt-3">
                    <h5>Heat Mortality Risk Index (HMRI)</h5>
                    <h1 id="hmriValue">Loading...</h1>
                </div>

                <div class="card metric-card bg-info-subtle border-info mt-3">
                    <h5>Risk Level</h5>
                    <h1 id="riskLevel">Loading...</h1>
                </div>

            </div>
        </div>
    </div>

    <script>
        const wardSelect = document.getElementById("wardSelect");

        let wardPredictions = [];

        async function loadWards() {
            try {
                const response = await fetch("/api/predict/wards", {
                    method: "POST",
                    headers: {
                        "Content-Type": "application/json",
                        "Accept": "application/json"
                    },
                    body: JSON.stringify({
                        temp_mean_c: 35,
                        temp_max_c: 40,
                        temp_min_c: 30,
                        humidity_pct: 60,
                        wind_speed_ms: 2,
                        solar_radiation_kwh_m2: 5
                    })
                });

                if (!response.ok) {
                    throw new Error("Unable to load ward predictions");
                }

                const data = await response.json();

                wardPredictions = Array.isArray(data) ? data : [];

                wardSelect.innerHTML = "";

                wardPredictions.forEach(ward => {
                    const option = document.createElement("option");

                    option.value = ward.ward_id;
                    option.textContent = ward.ward_name;

                    wardSelect.appendChild(option);
                });

                if (wardPredictions.length === 0) {
                    wardSelect.innerHTML =
                        '<option value="">No wards available</option>';
                    return;
                }

                updateWardMetrics();

            } catch (error) {
                console.error("Ward loading error:", error);

                wardSelect.innerHTML =
                    '<option value="">Failed to load wards</option>';

                showError();
            }
        }

        function updateWardMetrics() {
            const wardID = Number(wardSelect.value);

            const selectedWard = wardPredictions.find(
                ward => ward.ward_id === wardID
            );

            if (!selectedWard) {
                showError();
                return;
            }

            const prediction = selectedWard.prediction?.["3d"];

            if (!prediction) {
                showError();
                return;
            }

            const wbgt = Number(prediction.wbgt_c);
            const hmri = Number(prediction.hmri);
            const risk = prediction.risk_level;

            document.getElementById("wbgtValue").textContent =
                Number.isFinite(wbgt) ? wbgt.toFixed(2) + "°C" : "Unavailable";

            document.getElementById("hmriValue").textContent =
                Number.isFinite(hmri) ? hmri.toFixed(2) : "Unavailable";

            document.getElementById("riskLevel").textContent =
                risk || "Unavailable";
        }

        function showError() {
            document.getElementById("wbgtValue").textContent = "Unavailable";
            document.getElementById("hmriValue").textContent = "Unavailable";
            document.getElementById("riskLevel").textContent = "Unavailable";
        }

        wardSelect.addEventListener("change", updateWardMetrics);

        document.addEventListener("DOMContentLoaded", loadWards);

        window.addEventListener("load", function () {
            setTimeout(function () {
                if (typeof map !== "undefined" && map) {
                    map.invalidateSize();
                }
            }, 500);
        });

        window.addEventListener("resize", function () {
            if (typeof map !== "undefined" && map) {
                map.invalidateSize();
            }
        });
    </script>