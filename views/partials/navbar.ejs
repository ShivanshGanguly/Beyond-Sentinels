<style>
    #mainNavbar {
        width: 100%;
        min-height: 75px;
        background-color: #ffffff;
        border-bottom: 1px solid #e5e7eb;
        padding: 10px 25px;
        position: sticky;
        top: 0;
        left: 0;
        width: 100%;
        z-index: 1030;
        transition: background-color 0.3s ease, box-shadow 0.3s ease;
    }

    #mainNavbar .container-fluid {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 20px;
    }

    #mainNavbar .navbar-brand {
        color: #dc3545;
        font-size: 1.5rem;
        font-weight: 700;
        text-decoration: none;
        white-space: nowrap;
        margin: 0;
    }

    #mainNavbar .navbar-nav {
        display: flex;
        flex-direction: row;
        align-items: center;
        gap: 12px;
        margin: 0 auto;
    }

    #mainNavbar .nav-link {
        color: #071b3a;
        font-size: 1.05rem;
        font-weight: 500;
        padding: 10px 18px;
        border-radius: 8px;
        text-decoration: none;
        white-space: nowrap;
        transition: background-color 0.3s ease, color 0.3s ease;
    }

    #mainNavbar .nav-link:hover,
    #mainNavbar .nav-link.active {
        background-color: #fd0000;
        color: #ffffff !important;
    }

    #mainNavbar .user-section {
        display: flex;
        align-items: center;
        margin-left: auto;
    }

    #mainNavbar.scrolled {
        background-color: #ffffff;
        box-shadow: 0 3px 12px rgba(0, 0, 0, 0.12);
    }

    #mainNavbar .navbar-text {
        color: #071b3a;
        font-size: 1rem;
        font-weight: 700;
        white-space: nowrap;
        margin: 0;
    }

    #sidebarToggle {
        display: none;
        border: 1px solid #e5e7eb;
        border-radius: 8px;
        background-color: white;
        color: #071b3a;
        width: 40px;
        height: 40px;
        cursor: pointer;
        align-items: center;
        justify-content: center;
    }

    #sidebarToggle:hover {
        background-color: #de4343;
        color: white;
    }

    .main-content,
    .main-content.sidebar-collapsed {
        margin-left: 0;
    }

    @media(max-width:991px) {
        #mainNavbar {
            padding: 12px 16px;
        }

        #mainNavbar .container-fluid {
            flex-wrap: wrap;
            gap: 10px;
        }

        #sidebarToggle {
            display: flex;
            order: 3;
            margin-left: auto;
        }

        #mainNavbar .navbar-brand {
            font-size: 1.4rem;
        }

        #mainNavbar .navbar-nav {
            display: none;
            width: 100%;
            flex-direction: column;
            align-items: stretch;
            order: 4;
            gap: 5px;
            margin: 10px 0 0;
        }

        #mainNavbar.menu-open .navbar-nav {
            display: flex;
        }

        #mainNavbar .nav-link {
            width: 100%;
            padding: 11px 15px;
        }

        #mainNavbar .user-section {
            display: none;
            width: 100%;
            order: 5;
            margin: 5px 0 0;
            padding: 12px 15px;
            border-top: 1px solid #e5e7eb;
        }

        #mainNavbar.menu-open .user-section {
            display: flex;
        }
    }

    @media(max-width:575px) {
        #mainNavbar {
            padding: 10px 12px;
        }

        #mainNavbar .navbar-brand {
            font-size: 1.15rem;
        }

        #sidebarToggle {
            width: 36px;
            height: 36px;
        }

        #mainNavbar .nav-link {
            font-size: 0.95rem;
            padding: 10px 12px;
        }
    }
</style>

<nav id="mainNavbar" class="navbar">
    <div class="container-fluid">
        <a class="navbar-brand" href="/">HeatAwareness </a>
        <button id="sidebarToggle" type="button" aria-label="Toggle navigation" aria-expanded="false">
            <span id="toggleIcon">☰</span>
        </button>
        <div class="navbar-nav">
            <a class="nav-link" href="#risk">Heatmap</a>
            <a class="nav-link" href="#intervene">Intervene</a>
            <a class="nav-link" href="#comparision">Comparision</a>
        </div>
        <div class="user-section">
            <span class="navbar-text">Welcome, Beyond</span>
        </div>
    </div>
</nav>

<script>
    document.addEventListener("DOMContentLoaded", function () {
        const navbar = document.getElementById("mainNavbar");
        const toggleButton = document.getElementById("sidebarToggle");
        const toggleIcon = document.getElementById("toggleIcon");
        const navlinks = document.querySelectorAll("#mainNavbar .nav-link");

        toggleButton.addEventListener("click", function () {
            navbar.classList.toggle("menu-open");
            const isOpen = navbar.classList.contains("menu-open");
            toggleButton.setAttribute("aria-expanded", String(isOpen));
            toggleIcon.textContent = isOpen ? "✕" : "☰";
        });
    });
</script>