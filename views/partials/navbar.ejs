<style>
    #mainNavbar {
        width: 100%;
        min-height: 76px;
        background: linear-gradient(110deg, #0b1f33 0%, #12334a 100%);
        border-bottom: 1px solid rgba(255, 255, 255, 0.08);
        padding: 10px 28px;
        position: sticky;
        top: 0;
        left: 0;
        z-index: 1030;
        box-shadow: 0 4px 18px rgba(7, 27, 58, 0.14);
        transition: background 0.3s ease, box-shadow 0.3s ease;
    }

    #mainNavbar .container-fluid {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 24px;
    }

    #mainNavbar .navbar-brand {
        color: #ffffff;
        font-size: 1.55rem;
        font-weight: 800;
        letter-spacing: -0.5px;
        text-decoration: none;
        white-space: nowrap;
        margin: 0;
        transition: color 0.25s ease;
    }

    #mainNavbar .navbar-brand::before {
        content: "";
        display: inline-block;
        width: 9px;
        height: 9px;
        margin-right: 10px;
        margin-bottom: 3px;
        border-radius: 50%;
        background: #35d0ba;
        box-shadow: 0 0 12px rgba(53, 208, 186, 0.6);
    }

    #mainNavbar .navbar-brand:hover {
        color: #72ead9;
    }

    #mainNavbar .navbar-nav {
        display: flex;
        flex-direction: row;
        align-items: center;
        gap: 8px;
        margin: 0 auto;
    }

    #mainNavbar .nav-link {
        position: relative;
        color: #d1deea;
        font-size: 0.98rem;
        font-weight: 600;
        padding: 11px 18px;
        border-radius: 8px;
        text-decoration: none;
        white-space: nowrap;
        transition: background-color 0.25s ease, color 0.25s ease, transform 0.25s ease;
    }

    #mainNavbar .nav-link:hover {
        background-color: rgba(53, 208, 186, 0.12);
        color: #72ead9;
        transform: translateY(-1px);
    }

    #mainNavbar .nav-link.active {
        background-color: #35d0ba;
        color: #092536 !important;
        font-weight: 700;
        box-shadow: 0 3px 10px rgba(53, 208, 186, 0.18);
    }

    #mainNavbar .user-section {
        display: flex;
        align-items: center;
        margin-left: auto;
        padding-left: 20px;
        border-left: 1px solid rgba(255, 255, 255, 0.15);
    }

    #mainNavbar .navbar-text {
        color: #e1edf5;
        font-size: 0.95rem;
        font-weight: 600;
        white-space: nowrap;
        margin: 0;
    }

    #mainNavbar.scrolled {
        background: #0b1f33;
        box-shadow: 0 6px 22px rgba(0, 0, 0, 0.22);
    }

    #sidebarToggle {
        display: none;
        border: 1px solid rgba(255, 255, 255, 0.2);
        border-radius: 9px;
        background-color: rgba(255, 255, 255, 0.06);
        color: #ffffff;
        width: 42px;
        height: 42px;
        cursor: pointer;
        align-items: center;
        justify-content: center;
        font-size: 1.2rem;
        transition: background-color 0.25s ease, border-color 0.25s ease;
    }

    #sidebarToggle:hover {
        background-color: #35d0ba;
        border-color: #35d0ba;
        color: #092536;
    }

    #sidebarToggle:focus-visible,
    #mainNavbar .nav-link:focus-visible,
    #mainNavbar .navbar-brand:focus-visible {
        outline: 2px solid #72ead9;
        outline-offset: 3px;
    }

    .main-content,
    .main-content.sidebar-collapsed {
        margin-left: 0;
    }

    @media (max-width: 991px) {
        #mainNavbar {
            padding: 12px 18px;
        }

        #mainNavbar .container-fluid {
            flex-wrap: wrap;
            gap: 12px;
        }

        #mainNavbar .navbar-brand {
            font-size: 1.4rem;
        }

        #sidebarToggle {
            display: flex;
            order: 2;
            margin-left: auto;
        }

        #mainNavbar .navbar-nav {
            display: none;
            width: 100%;
            flex-direction: column;
            align-items: stretch;
            order: 3;
            gap: 5px;
            margin: 8px 0 0;
            padding-top: 10px;
            border-top: 1px solid rgba(255, 255, 255, 0.12);
        }

        #mainNavbar.menu-open .navbar-nav {
            display: flex;
        }

        #mainNavbar .nav-link {
            width: 100%;
            padding: 12px 15px;
        }

        #mainNavbar .user-section {
            display: none;
            width: 100%;
            order: 4;
            margin: 4px 0 0;
            padding: 13px 15px 5px;
            border-left: none;
            border-top: 1px solid rgba(255, 255, 255, 0.12);
        }

        #mainNavbar.menu-open .user-section {
            display: flex;
        }
    }

    @media (max-width: 575px) {
        #mainNavbar {
            padding: 10px 13px;
        }

        #mainNavbar .navbar-brand {
            font-size: 1.2rem;
        }

        #mainNavbar .navbar-brand::before {
            width: 8px;
            height: 8px;
            margin-right: 7px;
        }

        #sidebarToggle {
            width: 38px;
            height: 38px;
        }

        #mainNavbar .nav-link {
            font-size: 0.95rem;
            padding: 11px 12px;
        }
    }

    @media (prefers-reduced-motion: reduce) {

        #mainNavbar,
        #mainNavbar *,
        #sidebarToggle {
            transition: none !important;
        }
    }
</style>

<nav id="mainNavbar" class="navbar">
    <div class="container-fluid">
        <a class="navbar-brand" href="/">HeatAwareness</a>

        <button id="sidebarToggle" type="button" aria-label="Open navigation" aria-expanded="false"
            aria-controls="mainNavLinks">
            <span id="toggleIcon" aria-hidden="true">☰</span>
        </button>

        <div class="navbar-nav" id="mainNavLinks">
            <a class="nav-link" href="#risk">Heatmap</a>
            <a class="nav-link" href="#intervene">Intervene</a>
            <a class="nav-link" href="#comparision">Comparison</a>
        </div>

        <div class="user-section">
            <span class="navbar-text">Welcome, Beyond</span>
        </div>
    </div>
</nav>

<script>
    document.addEventListener("DOMContentLoaded", function () {
        const navbar = document.getElementById("mainNavbar");
        const toggleButton = document.getElementById("sidebarToggle");
        const toggleIcon = document.getElementById("toggleIcon");
        const navLinks = document.querySelectorAll("#mainNavbar .nav-link");

        if (!navbar || !toggleButton || !toggleIcon) return;

        toggleButton.addEventListener("click", function () {
            const isOpen = navbar.classList.toggle("menu-open");

            toggleButton.setAttribute("aria-expanded", String(isOpen));
            toggleButton.setAttribute("aria-label", isOpen ? "Close navigation" : "Open navigation");
            toggleIcon.textContent = isOpen ? "✕" : "☰";
        });

        navLinks.forEach(function (link) {
            link.addEventListener("click", function () {
                navbar.classList.remove("menu-open");
                toggleButton.setAttribute("aria-expanded", "false");
                toggleButton.setAttribute("aria-label", "Open navigation");
                toggleIcon.textContent = "☰";
            });
        });

        function updateNavbar() {
            navbar.classList.toggle("scrolled", window.scrollY > 20);
        }

        window.addEventListener("scroll", updateNavbar, { passive: true });
        updateNavbar();

        const sections = Array.from(navLinks)
            .map(link => document.querySelector(link.getAttribute("href")))
            .filter(Boolean);

        if ("IntersectionObserver" in window && sections.length) {
            const observer = new IntersectionObserver(function (entries) {
                entries.forEach(function (entry) {
                    if (entry.isIntersecting) {
                        navLinks.forEach(function (link) {
                            const isActive = link.getAttribute("href") === "#" + entry.target.id;

                            link.classList.toggle("active", isActive);

                            if (isActive) {
                                link.setAttribute("aria-current", "location");
                            } else {
                                link.removeAttribute("aria-current");
                            }
                        });
                    }
                });
            }, {
                rootMargin: "-20% 0px -65% 0px",
                threshold: 0
            });

            sections.forEach(section => observer.observe(section));
        }
    });
</script>